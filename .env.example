# ==========================================
# DevCollab Environment Configuration
# ==========================================

# Backend Settings
PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/devcollab?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_jwt_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://<YOUR_EC2_PUBLIC_IP_OR_DOMAIN>

# Frontend Build Arguments (optional, defaults to reverse-proxy paths)
VITE_BASE_URL=/api
VITE_SOCKET_URL=/

# Observability & SRE (Grafana & Prometheus)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

